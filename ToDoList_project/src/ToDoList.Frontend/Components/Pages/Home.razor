@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1 class="mb-3 fw-bold text-dark">Farma zvířat &#x1F33F;</h1>

<p class="lead text-muted border-bottom pb-3">Vítáme vás na farmě zvířat! <br />Můžete zde spravovat svůj každodenní seznam farmářských úkolů a starat se o svá
    virtuální hospodářská zvířátka &#x1F42E;</p>


<div class="d-flex justify-content-end mb-0">
    <button type="button" class="btn btn-warning fw-bold" @onclick="ShowModal"><i class="bi bi-tags me-2"></i>Přidej kategorii</button>
</div>

<Dashboard />

<CreateCategoryModal IsVisible="showModal" OnCategoryCreated="OnCategoryCreated" />

@code {
    private bool showModal = false;

    private void ShowModal()
    {
        showModal = true;
    }

    private void OnCategoryCreated()
    {
        showModal = false;
        // Optionally refresh Dashboard or show message
    }
}
